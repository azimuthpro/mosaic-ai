# Supabase Configuration
# Get these from your Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Firecrawl API Key
# Get this from https://firecrawl.dev
FIRECRAWL_API_KEY=your-firecrawl-api-key

# Vercel AI Gateway (all model calls route through it)
# Optional on Vercel and after `vercel env pull`, which provisions a
# VERCEL_OIDC_TOKEN used automatically. Set this for CI or non-Vercel hosts.
# Get this from https://vercel.com/<team>/~/ai/api-keys
AI_GATEWAY_API_KEY=your-ai-gateway-api-key

# Tavily API Key (Web Search)
# Get this from https://tavily.com
TAVILY_API_KEY=your-tavily-api-key

# Slack Integration (Optional)
# Create a Slack app at https://api.slack.com/apps
# Required scopes: channels:read, channels:history, groups:read, groups:history, chat:write, reactions:write
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
# Signing secret for verifying incoming Slack Events API requests
# Found in your Slack app settings under "Basic Information" -> "App Credentials"
SLACK_SIGNING_SECRET=your-slack-signing-secret

# SendGrid (Optional - for email notifications)
SENDGRID_API_KEY=your-sendgrid-api-key
# Sender identity (defaults to noreply@mosaic-ai.app / "Mosaic AI")
SENDGRID_FROM_EMAIL=noreply@your-domain.com
SENDGRID_FROM_NAME=Mosaic AI

# GitHub Integration (Optional - github_issue tiles)
# Create an OAuth app at https://github.com/settings/developers
# Callback URL: <app-url>/api/auth/github/callback
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Google Integration (Optional - catalog Google Sheets sync)
# Create an OAuth client at https://console.cloud.google.com
# Redirect URI: <app-url>/api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Public base URL used to build OAuth redirect URIs (Slack, GitHub, Google)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Public base URL used in magic-link and invitation emails
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Vercel Cron Secret
# Generate a secure random string for cron job authentication
# You can generate one with: openssl rand -hex 32
CRON_SECRET=your-cron-secret
