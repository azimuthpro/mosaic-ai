# Supabase Configuration
# Get these from your Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Firecrawl API Key
# Get this from https://firecrawl.dev
FIRECRAWL_API_KEY=your-firecrawl-api-key

# Google Generative AI (Gemini) API Key
# Get this from https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=your-google-ai-api-key

# Tavily API Key (Web Search)
# Get this from https://tavily.com
TAVILY_API_KEY=your-tavily-api-key

# Slack Integration (Optional)
# Create a Slack app at https://api.slack.com/apps
# Required scopes: channels:read, channels:history, groups:read, groups:history, chat:write
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret

# SendGrid (Optional - for email notifications)
SENDGRID_API_KEY=your-sendgrid-api-key

# Vercel Cron Secret
# Generate a secure random string for cron job authentication
# You can generate one with: openssl rand -hex 32
CRON_SECRET=your-cron-secret
